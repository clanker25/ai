{
  "compilerOptions": {
    "strict": true,
    "declaration": false,
    "sourceMap": false,
    "target": "es2022",
    "module": "esnext",
    "types": [
      "node"
    ],
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "moduleResolution": "Bundler",
    "rootDir": "./src",
    "outDir": "./build",
    "composite": true
  },
  "include": [
    "src/**/*.ts"
  ],
  "references": [
    {
      "path": "../../packages/ai"
    },
    {
      "path": "../../packages/mcp"
    },
    {
      "path": "../../packages/openai"
    }
  ]
}
